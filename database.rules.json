{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['game', 'createdAt'])",
          "game": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "state": { ".validate": "newData.isString() && newData.val().length <= 200000" },
        "inputs": {
          "$pid": { ".validate": "$pid.length <= 40 && newData.isString() && newData.val().length <= 4000" }
        },
        "presence": {
          "$pid": { ".validate": "$pid.length <= 40 && newData.isString() && newData.val().length <= 8" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
